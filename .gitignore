# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally check in Pipfile.lock.
#   For libraries, see also https://pipenv.pypa.io/en/latest/advanced/#pipfile-vs-setup-py
#   For applications, these should be committed.
# Pipfile.lock

# poetry
#   Packages should check in poetry.lock, but we ignore virtualenvs if created locally
.venv/
poetry.lock

# PEP 582; used by e.g. pdm
__pypackages__/

